# Copy this file to .env and fill in real values before running the server.

# --- Server ---
# PORT=4000
# Public URL of this app itself — frontend and API are served from the same
# origin, so this is used to build the email-verification link.
APP_URL=http://localhost:4000

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=packsomework

# --- Uploaded media (Cloudflare R2) ---
# Posts, stories, and profile photos upload here instead of local disk, so
# they survive redeploys on hosts that don't guarantee a persistent
# filesystem. Create a bucket at dash.cloudflare.com > R2, then an API
# token under "Manage R2 API Tokens" for the access key/secret. R2_PUBLIC_URL
# is the bucket's public access URL (enable it under the bucket's Settings,
# or use a custom domain) — no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Outgoing email (verification links + OTP codes) ---
# Recommended on hosts with restricted SMTP: use Resend's HTTPS API.
# Verify your sending domain in Resend and add these to production Secrets.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM=PackSomeWork <no-reply@packsomework.com>
# When Resend is not configured, the hosting gateway is tried, then SMTP.
# Missing transports raise an error; email codes are never logged as a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PackSomeWork <no-reply@packsomework.com>"
