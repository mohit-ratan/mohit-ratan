# Copy this file to .env and fill in real values before running the server.

# --- Server ---
# PORT=4000
# Public URL of this app itself — frontend and API are served from the same
# origin, so this is used to build the email-verification link.
APP_URL=http://localhost:4000

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=packsomework

# --- Outgoing email (verification links + OTP codes) ---
# Without these set, the server logs emails to the console instead of sending them —
# fine for local testing, but real registration/verification needs real SMTP creds.
# You can use GoDaddy's own email hosting for your domain, or a service like
# Gmail (with an App Password), SendGrid, Mailgun, Resend, Postmark, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PackSomeWork <no-reply@packsomework.com>"
