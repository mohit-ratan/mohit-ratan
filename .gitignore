# Dependencies (GoDaddy installs these automatically from package.json)
node_modules
client/node_modules

# Secrets
.env

# Built frontend — GoDaddy Node.js Hosting runs `npm run build` itself on
# every deploy, so committing this output only leaves the build container's
# git checkout dirty and blocks the next `git pull`. Build locally with
# `npm run build` when you need to preview the production bundle.
public/index.html
public/favicon.svg
public/icons.svg
public/assets/*.js
public/assets/*.css

# Legacy local-disk upload path — uploads now go to Cloudflare R2 (see
# src/lib/storage.js) since this directory doesn't survive every host's
# redeploy. Left ignored in case anything still references it locally.
public/assets/uploads/*
!public/assets/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated copy of the sharing image; source lives under client/public.
public/brand/share.png
